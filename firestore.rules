rules_version = '2';

// LGI website (project: lgi-foundation) - locked-down Firestore rules.
// Written from how the current code uses Firestore:
//   lgi-blog-posts            read by everyone, written by the blog admin (AdminBlog.jsx)
//   lgi-blog-posts/*/comments read by everyone, created by visitors (SingleBlog.jsx)
//   lgi-feedback              created by visitors, readable only by the admin (Feedback.jsx)
// Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // Blog admin sign-in email (same address the previous live rules allowed).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['langlopact@gmail.com'];
    }

    match /lgi-blog-posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'timestamp'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.timestamp is timestamp;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /lgi-feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'category', 'rating', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 60
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Default: deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
